#!/usr/bin/bash
set -euo pipefail

# Usage:
#   ./seed.sh /path/to/torrents /path/to/media [webtorrent args...]
#
# Example:
#   ./seed.sh ~/torrents ~/media seed --keep-seeding *.torrent

TORRENTS_DIR=$(realpath "$1")
MEDIA_DIR=$(realpath "$2")
PORT=$3
shift 3

IMAGE="webtorrent"

set -x
makemagnet() {
	echo "magnet:?xt=urn:btih:$(nix shell nixpkgs#transmission_4 --command transmission-show -i "$1"  | awk '/Hash v1:/ {print $3}')"
}
mapfile -t TORRENTS < <(find "$TORRENTS_DIR" -maxdepth 1 -type f -name '*.torrent' -print0 | xargs -0 -n1 basename)
#mapfile -t MAGNETS < <(for t in "${TORRENTS[@]}"; do makemagnet "$t"; done)
exec docker run --rm --entrypoint npx --tty --interactive \
  --name webtorrent-seeder \
  --publish "${PORT}:6881" \
  --volume "${TORRENTS_DIR}:/torrents:ro" \
  --volume "${MEDIA_DIR}:/media:ro" \
  "${IMAGE}" webtorrent seed "${TORRENTS[@]/#//torrents/}" --out /media --keep-seeding "$@"
